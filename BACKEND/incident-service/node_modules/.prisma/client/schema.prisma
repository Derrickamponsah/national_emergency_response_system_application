// ============================================
// INCIDENT SERVICE - PRISMA SCHEMA
// ============================================
// Database: emergency_incidents_db

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// RESPONDERS TABLE
// ============================================
model Responder {
  responderId String        @id @default(uuid()) @map("responder_id") @db.Uuid
  name        String        @db.VarChar(255)
  email       String        @unique @db.VarChar(255)
  phone       String        @db.VarChar(20)
  type        ResponderType
  location    String        @db.VarChar(255)
  region      String?       @db.VarChar(100)
  capacity    Int           @default(0)
  currentLoad Int           @default(0) @map("current_load")
  latitude    Decimal?      @db.Decimal(10, 8)
  longitude   Decimal?      @db.Decimal(11, 8)
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at")

  assignedIncidents Incident[]          @relation("AssignedResponder")
  incidentLinks     IncidentResponder[]

  @@index([type])
  @@index([region])
  @@index([isActive])
  @@index([latitude, longitude])
  @@map("responders")
}

// ============================================
// INCIDENTS TABLE
// ============================================
model Incident {
  incidentId          String         @id @default(uuid()) @map("incident_id") @db.Uuid
  title               String         @db.VarChar(255)
  description         String?        @db.Text
  type                IncidentType
  location            String         @db.VarChar(255)
  region              String?        @db.VarChar(100)
  latitude            Decimal?       @db.Decimal(10, 8)
  longitude           Decimal?       @db.Decimal(11, 8)
  severity            Severity       @default(MEDIUM)
  status              IncidentStatus @default(CREATED)
  assignedResponderId String?        @map("assigned_responder_id") @db.Uuid
  reporterName        String?        @map("reporter_name") @db.VarChar(255)
  reporterPhone       String?        @map("reporter_phone") @db.VarChar(20)
  createdBy           String?        @map("created_by") @db.Uuid
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @default(now()) @updatedAt @map("updated_at")
  resolvedAt          DateTime?      @map("resolved_at")

  assignedResponder Responder?          @relation("AssignedResponder", fields: [assignedResponderId], references: [responderId])
  responderLinks    IncidentResponder[]

  @@index([type])
  @@index([region])
  @@index([status])
  @@index([assignedResponderId])
  @@index([latitude, longitude])
  @@map("incidents")
}

// ============================================
// INCIDENT RESPONDERS JUNCTION TABLE
// ============================================
model IncidentResponder {
  id          String    @id @default(uuid()) @db.Uuid
  incidentId  String    @map("incident_id") @db.Uuid
  responderId String    @map("responder_id") @db.Uuid
  assignedAt  DateTime  @default(now()) @map("assigned_at")
  arrivedAt   DateTime? @map("arrived_at")
  completedAt DateTime? @map("completed_at")
  notes       String?   @db.Text

  incident  Incident  @relation(fields: [incidentId], references: [incidentId], onDelete: Cascade)
  responder Responder @relation(fields: [responderId], references: [responderId], onDelete: Cascade)

  @@unique([incidentId, responderId])
  @@index([incidentId])
  @@index([responderId])
  @@map("incident_responders")
}

// ============================================
// ENUMS
// ============================================
enum ResponderType {
  HOSPITAL
  POLICE
  FIRE_STATION
}

enum IncidentType {
  MEDICAL
  FIRE
  CRIME
  ROAD_ACCIDENT
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  CREATED
  DISPATCHED
  IN_PROGRESS
  RESOLVED
}
