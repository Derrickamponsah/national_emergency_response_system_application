// ============================================
// ANALYTICS SERVICE - PRISMA SCHEMA
// ============================================
// Database: emergency_analytics_db

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// INCIDENT EVENTS TABLE
// ============================================
model IncidentEvent {
  eventId               String                @id @default(uuid()) @map("event_id") @db.Uuid
  incidentId            String                @map("incident_id") @db.Uuid
  incidentType          AnalyticsIncidentType @map("incident_type")
  location              String                @db.VarChar(255)
  region                String?               @db.VarChar(100)
  severity              AnalyticsSeverity
  responseTimeSeconds   Int                   @default(0) @map("response_time_seconds")
  resolutionTimeSeconds Int?                  @default(0) @map("resolution_time_seconds")
  responderCount        Int                   @default(1) @map("responder_count")
  vehicleCount          Int                   @default(0) @map("vehicle_count")
  casualties            Int                   @default(0)
  injuries              Int                   @default(0)
  status                AnalyticsEventStatus  @default(REPORTED)
  createdAt             DateTime              @default(now()) @map("created_at")
  resolvedAt            DateTime?             @map("resolved_at")

  @@index([incidentId])
  @@index([incidentType])
  @@index([region])
  @@index([createdAt])
  @@index([status])
  @@map("incident_events")
}

// ============================================
// RESPONSE METRICS TABLE
// ============================================
model ResponseMetric {
  metricId                     String   @id @default(uuid()) @map("metric_id") @db.Uuid
  incidentType                 String   @map("incident_type") @db.VarChar(50)
  dateRecorded                 DateTime @default(now()) @map("date_recorded") @db.Date
  avgResponseTimeSeconds       Int?     @map("avg_response_time_seconds")
  avgResolutionTimeSeconds     Int?     @map("avg_resolution_time_seconds")
  totalIncidents               Int      @default(0) @map("total_incidents")
  resolvedIncidents            Int      @default(0) @map("resolved_incidents")
  pendingIncidents             Int      @default(0) @map("pending_incidents")
  averageRespondersPerIncident Int      @default(1) @map("average_responders_per_incident")
  recordedAt                   DateTime @default(now()) @map("recorded_at")

  @@index([incidentType])
  @@index([dateRecorded])
  @@map("response_metrics")
}

// ============================================
// RESOURCE UTILIZATION TABLE
// ============================================
model ResourceUtilization {
  utilizationId         String                @id @default(uuid()) @map("utilization_id") @db.Uuid
  resourceType          AnalyticsResourceType @map("resource_type")
  dateRecorded          DateTime              @default(now()) @map("date_recorded") @db.Date
  totalResources        Int                   @default(0) @map("total_resources")
  busyResources         Int                   @default(0) @map("busy_resources")
  idleResources         Int                   @default(0) @map("idle_resources")
  utilizationPercentage Decimal               @default(0) @map("utilization_percentage") @db.Decimal(5, 2)
  region                String?               @db.VarChar(100)
  recordedAt            DateTime              @default(now()) @map("recorded_at")

  @@index([resourceType])
  @@index([dateRecorded])
  @@index([region])
  @@map("resource_utilization")
}

// ============================================
// DAILY SUMMARY TABLE
// ============================================
model DailySummary {
  summaryId                String   @id @default(uuid()) @map("summary_id") @db.Uuid
  summaryDate              DateTime @unique @default(now()) @map("summary_date") @db.Date
  totalIncidents           Int      @default(0) @map("total_incidents")
  medicalIncidents         Int      @default(0) @map("medical_incidents")
  fireIncidents            Int      @default(0) @map("fire_incidents")
  crimeIncidents           Int      @default(0) @map("crime_incidents")
  roadIncidents            Int      @default(0) @map("road_incidents")
  criticalIncidents        Int      @default(0) @map("critical_incidents")
  highPriorityIncidents    Int      @default(0) @map("high_priority_incidents")
  avgResponseTimeSeconds   Int      @default(0) @map("avg_response_time_seconds")
  avgResolutionTimeSeconds Int      @default(0) @map("avg_resolution_time_seconds")
  totalRespondersDeployed  Int      @default(0) @map("total_responders_deployed")
  totalVehiclesDeployed    Int      @default(0) @map("total_vehicles_deployed")
  createdAt                DateTime @default(now()) @map("created_at")

  @@index([summaryDate(sort: Desc)])
  @@map("daily_summary")
}

// ============================================
// HOSPITAL BED STATISTICS TABLE
// ============================================
model HospitalBedStatistic {
  statId            String   @id @default(uuid()) @map("stat_id") @db.Uuid
  hospitalId        String   @map("hospital_id") @db.Uuid
  hospitalName      String   @map("hospital_name") @db.VarChar(255)
  region            String?  @db.VarChar(100)
  totalBeds         Int      @default(0) @map("total_beds")
  occupiedBeds      Int      @default(0) @map("occupied_beds")
  availableBeds     Int      @default(0) @map("available_beds")
  icuBeds           Int      @default(0) @map("icu_beds")
  icuOccupied       Int      @default(0) @map("icu_occupied")
  emergencyBeds     Int      @default(0) @map("emergency_beds")
  emergencyOccupied Int      @default(0) @map("emergency_occupied")
  occupancyRate     Decimal  @default(0) @map("occupancy_rate") @db.Decimal(5, 2)
  dateRecorded      DateTime @default(now()) @map("date_recorded") @db.Date
  recordedAt        DateTime @default(now()) @map("recorded_at")

  @@index([hospitalId])
  @@index([dateRecorded])
  @@index([region])
  @@map("hospital_bed_statistics")
}

// ============================================
// RESPONDER DEPLOYMENT METRICS TABLE
// ============================================
model ResponderDeploymentMetric {
  metricId                 String                 @id @default(uuid()) @map("metric_id") @db.Uuid
  responderId              String                 @map("responder_id") @db.Uuid
  responderName            String                 @map("responder_name") @db.VarChar(255)
  responderType            AnalyticsResponderType @map("responder_type")
  dateRecorded             DateTime               @default(now()) @map("date_recorded") @db.Date
  totalDeployments         Int                    @default(0) @map("total_deployments")
  totalIncidentsHandled    Int                    @default(0) @map("total_incidents_handled")
  avgResponseTimeSeconds   Int?                   @map("avg_response_time_seconds")
  avgResolutionTimeSeconds Int?                   @map("avg_resolution_time_seconds")
  totalHoursDeployed       Int                    @default(0) @map("total_hours_deployed")
  availabilityPercentage   Decimal                @default(100) @map("availability_percentage") @db.Decimal(5, 2)
  region                   String?                @db.VarChar(100)
  recordedAt               DateTime               @default(now()) @map("recorded_at")

  @@index([responderId])
  @@index([responderType])
  @@index([dateRecorded])
  @@index([region])
  @@map("responder_deployment_metrics")
}

// ============================================
// ENUMS
// ============================================
enum AnalyticsIncidentType {
  MEDICAL
  FIRE
  CRIME
  ROAD_ACCIDENT
}

enum AnalyticsSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AnalyticsEventStatus {
  REPORTED
  RESPONSE_INITIATED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum AnalyticsResourceType {
  AMBULANCE
  FIRE_TRUCK
  POLICE_CAR
  HOSPITAL
  POLICE_STATION
  FIRE_STATION
}

enum AnalyticsResponderType {
  HOSPITAL
  POLICE
  FIRE_STATION
}
